# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL container
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# API (all required)
DATABASE_URL=postgresql+asyncpg://crm:change-me@db:5432/crm
# Generate at install time: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
MAX_PHOTO_MB=15
MAX_VIDEO_MB=200
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost
# Сум per 1 у.е.; prices are stored in у.е. and converted on display
UZS_PER_UE=12000

# Applied to every container
TZ=Asia/Tashkent

# Host port published by nginx
HTTP_PORT=80
